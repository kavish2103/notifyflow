# ==============================================================================
# NOTIFYFLOW CENTRAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' at the root of the project for local development.
# Do NOT commit your actual '.env' file containing real secrets to Git!

# ------------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
# Winston logging level. Options: error, warn, info, debug
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Matches credentials in docker-compose.yml for local development
DATABASE_URL=postgres://notifyflow_user:notifyflow_secure_password@localhost:5432/notifyflow_db

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (Upstash Redis in production, or local Redis for dev)
# ------------------------------------------------------------------------------
# Upstash Redis endpoint URL (starts with rediss:// for TLS security)
# Example: rediss://default:your-password@your-endpoint.upstash.io:32506
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# KAFKA CONFIGURATION (Upstash Managed Kafka)
# ------------------------------------------------------------------------------
# Comma-separated list of Kafka broker endpoints
# Example for Upstash: your-endpoint.upstash.io:9092
KAFKA_BROKERS=localhost:9092

# Upstash SASL SCRAM credentials. Leave blank if running against a local unauthenticated Kafka.
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CLIENT_ID=notifyflow-dev

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used by API Gateway to sign and verify client JWTs
JWT_SECRET=super_secret_notifyflow_gateway_jwt_signing_key_change_me_in_production

# ------------------------------------------------------------------------------
# DELIVERY PROVIDER CONFIGURATIONS
# ------------------------------------------------------------------------------

# 1. EMAIL PROVIDER (Nodemailer + Mailtrap for Dev sandbox testing)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_smtp_username
SMTP_PASS=your_mailtrap_smtp_password

# 2. SMS PROVIDER (Twilio API - Leave blank to use NotifyFlow Mock SMS Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 3. PUSH PROVIDER (Web Push - VAPID Keys generated by web-push library)
# Can generate these keys using 'npx web-push generate-vapid-keys'
VAPID_SUBJECT=mailto:admin@notifyflow.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# SERVICE NETWORKING PORTS & ROUTING
# ------------------------------------------------------------------------------
# Declares the port bindings for each individual Express service when running locally
GATEWAY_PORT=3000
INGESTION_PORT=3002
PREFERENCE_PORT=3003
ANALYTICS_PORT=3004
FRONTEND_PORT=5173

# Internal routing URLs (API Gateway proxy configuration)
INGESTION_SERVICE_URL=http://localhost:3002
PREFERENCE_SERVICE_URL=http://localhost:3003
