{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "services/sms-worker/**",
      "shared/logger/**",
      "shared/kafka/**",
      "shared/redis/**",
      "shared/schemas/**",
      "package*.json"
    ]
  },
  "deploy": {
    "startCommand": "node services/sms-worker/index.js",
    "restartPolicyType": "ON_FAILURE"
  }
}
